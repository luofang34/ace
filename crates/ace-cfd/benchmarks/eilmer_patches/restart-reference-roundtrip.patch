+// The reference and restart history must round-trip the saved binary64 values.
+// Decimal conversion through std.conv can move the value by one ULP.
+double parseRestartScalar(string token)
+{
+    import core.stdc.stdlib : strtod;
+    auto input = toStringz(token);
+    immutable(char)* end;
+    double value = strtod(input, &end);
+    if (end == input || end != input + token.length) {
+        throw new Exception("Invalid restart scalar: " ~ token);
+    }
+    return value;
+}
