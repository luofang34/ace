+void aceTraceFaces(string name)
+{
+    auto output = File(name, "w");
+    output.writeln("id,left,right,x,y,nx,ny,area,rho,p,T,u,v,S,gTx,gTy,mass,momx,momy,energy");
+    foreach (blk; localFluidBlocks) {
+        auto cqi = blk.myConfig.cqi;
+        foreach (f; blk.faces) {
+            output.writef("%d,%d,%d", f.id, f.left_cell is null ? -1 : f.left_cell.id,
+                          f.right_cell is null ? -1 : f.right_cell.id);
+            foreach (value; [f.pos.x, f.pos.y, f.n.x, f.n.y, f.area[0],
+                             f.fs.gas.rho, f.fs.gas.p, f.fs.gas.T, f.fs.vel.x, f.fs.vel.y,
+                             f.fs.S, f.grad.T[0], f.grad.T[1], f.F[cqi.mass],
+                             f.F[cqi.xMom], f.F[cqi.yMom], f.F[cqi.totEnergy]]) {
+                output.writef(",%.17e", value.re);
+            }
+            output.writeln();
+        }
+    }
+}
+void aceTraceCells()
+{
+    auto output = File("trace-cells.csv", "w");
+    output.writeln("id,x,y,rho,p,T,u,v,S,gTx,gTy,dudx,dudy,dvdx,dvdy,mass,momx,momy,energy");
+    foreach (blk; localFluidBlocks) {
+        auto cqi = blk.myConfig.cqi;
+        foreach (c; blk.cells) {
+            output.writef("%d",c.id);
+            foreach(value; [c.pos[0].x,c.pos[0].y,c.fs.gas.rho,c.fs.gas.p,c.fs.gas.T,
+                            c.fs.vel.x,c.fs.vel.y,c.fs.S,c.grad.T[0],c.grad.T[1],
+                            c.grad.vel[0][0],c.grad.vel[0][1],c.grad.vel[1][0],c.grad.vel[1][1],
+                            c.dUdt[0][cqi.mass],c.dUdt[0][cqi.xMom],c.dUdt[0][cqi.yMom],
+                            c.dUdt[0][cqi.totEnergy]]) output.writef(",%.17e",value.re);
+            output.writeln();
+        }
+    }
+}
