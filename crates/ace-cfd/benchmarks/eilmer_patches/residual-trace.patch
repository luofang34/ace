+void aceTraceIsobaricReconstruction()
+{
+    auto output=File("trace-isobaric-reconstruction.csv", "w");
+    output.writeln("id,x,y,expected_pressure,left_pressure,right_pressure,left_temperature,right_temperature");
+    foreach (blk; localFluidBlocks) {
+        auto structured=cast(SFluidBlock)blk;
+        if (structured is null) continue;
+        foreach (c; blk.cells) {
+            auto p=c.pos[0];
+            c.fs.gas.p=300.0;
+            c.fs.gas.T=300.0+3.0e4*(sqrt(p.x*p.x+p.y*p.y)-0.01);
+            blk.myConfig.gmodel.update_thermo_from_pT(c.fs.gas);
+            c.fs.vel.set(0.0,0.0,0.0);
+        }
+        foreach (f; blk.faces) {
+            if (f.left_cells.length<2 || f.right_cells.length<2) continue;
+            bool interior=true;
+            foreach (cells; [f.left_cells,f.right_cells]) {
+                foreach (c; cells) if (!c.is_interior_to_domain) interior=false;
+            }
+            if (!interior) continue;
+            auto left=FlowState(f.left_cells[0].fs);
+            auto right=FlowState(f.right_cells[0].fs);
+            structured.one_d.interp(f,left,right);
+            output.writefln("%d,%.17e,%.17e,%.17e,%.17e,%.17e,%.17e,%.17e",
+                f.id,f.pos.x.re,f.pos.y.re,300.0,left.gas.p.re,right.gas.p.re,
+                left.gas.T.re,right.gas.T.re);
+        }
+    }
+}
