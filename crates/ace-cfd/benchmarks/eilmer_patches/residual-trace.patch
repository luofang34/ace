+void aceTraceJacobian()
+{
+    // Probe the active continuous sensor or an outlet cell away from its corner.
+    bool outlet = exists("ace-trace-jacobian-outlet");
+    FVCell selected;
+    double radius = double.max;
+    foreach (blk; localFluidBlocks) foreach (c; blk.cells) {
+        bool candidate = c.fs.S > 0.02 && c.fs.S < 0.99 &&
+                         fabs(c.fs.vel.x).re < 0.95*c.fs.gas.a.re;
+        if (outlet) {
+            bool onOutlet = false;
+            bool onWall = false;
+            foreach (face; c.iface) if (face.is_on_boundary) {
+                onOutlet |= blk.bc[face.bc_id].type == "outflow_simple_flux_zero_normal_gradient";
+                onWall |= blk.bc[face.bc_id].is_wall_with_viscous_effects;
+            }
+            candidate = onOutlet && !onWall;
+        }
+        if (candidate && c.pos[0].y.re < radius) {
+            selected=c; radius=c.pos[0].y.re;
+        }
+    }
+    if (selected is null) return;
+    auto output=File("trace-jacobian.csv","w");
+    output.writeln("selected,epsilon,complex_step,updated_sensor,sign,id,mass,momx,momy,energy");
+    int ftl=to!int(GlobalConfig.n_flow_time_levels-1);
+    foreach (imaginary; [false,true]) foreach (epsilon; [1.0e-5,1.0e-6,1.0e-7]) {
+        foreach (updated; [false,true]) foreach (sign; [-1.0,1.0]) {
+            foreach (blk; localFluidBlocks) foreach (c; blk.cells) c.decode_conserved(0,0,blk.omegaz);
+            evalRHS(0.0,0);
+            foreach (blk; localFluidBlocks) {
+                auto cqi=blk.myConfig.cqi;
+                foreach (c; blk.cells) {
+                    c.U[ftl].copy_values_from(c.U[0]);
+                    if (c is selected) {
+                        auto change=sign*epsilon*100.0*c.U[0][cqi.mass].re;
+                        c.U[ftl][cqi.xMom] += imaginary ? complex(0.0,change) : complex(change,0.0);
+                    }
+                    c.decode_conserved(0,ftl,blk.omegaz);
+                }
+            }
+            evalRHS(0.0,ftl);
+            if (updated) { detect_shocks(0,ftl); evalRHS(0.0,ftl); }
+            foreach (blk; localFluidBlocks) {
+                auto cqi=blk.myConfig.cqi;
+                foreach (c; blk.cells) {
+                    output.writef("%d,%.17e,%d,%d,%.1f,%d", selected.id,epsilon,
+                        imaginary?1:0,updated?1:0,sign,c.id);
+                    foreach (k; [cqi.mass,cqi.xMom,cqi.yMom,cqi.totEnergy]) {
+                        auto value=c.dUdt[ftl][k];
+                        output.writef(",%.17e",imaginary?value.im/epsilon:value.re);
+                    }
+                    output.writeln();
+                }
+            }
+        }
+    }
+    foreach (blk; localFluidBlocks) foreach (c; blk.cells) c.decode_conserved(0,0,blk.omegaz);
+    evalRHS(0.0,0);
+}
+
+void aceTraceAxisThermal()
+{
+    foreach (direction; 0 .. 2) {
+        foreach (blk; localFluidBlocks) foreach (c; blk.cells) {
+            auto p=c.pos[0];
+            c.fs.gas.p=300.0;
+            c.fs.gas.T=300.0+1.0e6*(direction==0 ? p.y*p.y : p.x*p.x);
+            blk.myConfig.gmodel.update_thermo_from_pT(c.fs.gas);
+            blk.myConfig.gmodel.update_trans_coeffs(c.fs.gas);
+            c.fs.vel.set(0.0,0.0,0.0);
+            c.encode_conserved(0,0,blk.omegaz);
+        }
+        evalRHS(0.0,0);
+        auto output=File(direction==0 ? "trace-axis-thermal-radial.csv" :
+                                      "trace-axis-thermal-axial.csv", "w");
+        output.writeln("id,x,y,expected,actual,cell_gTx,cell_gTy,axis_T");
+        foreach (blk; localFluidBlocks) foreach (c; blk.cells) {
+            bool axis=false;
+            bool corner=false;
+            number axisTemperature=0.0;
+            foreach (f; c.iface) {
+                if (f.is_on_boundary && f.pos.y==0.0) {
+                    axis=true; axisTemperature=f.fs.gas.T;
+                } else if (f.is_on_boundary) corner=true;
+            }
+            if (!axis || corner) continue;
+            number divergence=0.0;
+            foreach (i,f; c.iface) {
+                divergence+=c.outsign[i]*f.q_conduction*f.area[0];
+            }
+            divergence/=c.volume[0];
+            number expected=(direction==0 ? 4.0e6 : 2.0e6)*c.fs.gas.k;
+            output.writefln("%d,%.17e,%.17e,%.17e,%.17e,%.17e,%.17e,%.17e",
+                c.id,c.pos[0].x.re,c.pos[0].y.re,expected.re,divergence.re,
+                c.grad.T[0].re,c.grad.T[1].re,axisTemperature.re);
+        }
+    }
+}
+
+void aceTraceBalancedStrain()
+{
+    foreach (blk; localFluidBlocks) foreach (c; blk.cells) {
+        auto p=c.pos[0];
+        c.fs.gas.p=10000.0-0.01*1.0e8*(2.0*p.x*p.x+0.5*p.y*p.y);
+        c.fs.gas.T=c.fs.gas.p/(0.01*287.05);
+        blk.myConfig.gmodel.update_thermo_from_pT(c.fs.gas);
+        blk.myConfig.gmodel.update_trans_coeffs(c.fs.gas);
+        c.fs.vel.x=-20000.0*p.x; c.fs.vel.y=10000.0*p.y; c.fs.vel.z=0.0;
+        c.encode_conserved(0,0,blk.omegaz);
+    }
+    evalRHS(0.0,0);
+    aceTraceCells();
+    aceTraceFaces("strain-equilibrium-total.csv");
+    std.file.rename("trace-cells.csv","strain-equilibrium-cells.csv");
+    std.file.rename("trace-inviscid.csv","strain-equilibrium-inviscid.csv");
+}
