+void aceTraceWallPipeline()
+{
+    number radius=0.0;
+    number wallTemperature=0.0;
+    foreach (blk; localFluidBlocks) foreach (f; blk.faces) {
+        if (f.is_on_boundary && blk.bc[f.bc_id].is_wall_with_viscous_effects) {
+            radius=sqrt(f.pos.x*f.pos.x+f.pos.y*f.pos.y);
+            wallTemperature=f.fs.gas.T;
+            break;
+        }
+    }
+    foreach (blk; localFluidBlocks) foreach (c; blk.cells) {
+        auto p=c.pos[0];
+        c.fs.gas.p=300.0;
+        c.fs.gas.T=wallTemperature+1.0e4*(sqrt(p.x*p.x+p.y*p.y)-radius);
+        blk.myConfig.gmodel.update_thermo_from_pT(c.fs.gas);
+        blk.myConfig.gmodel.update_trans_coeffs(c.fs.gas);
+        c.fs.vel.set(0.0,0.0,0.0);
+        c.encode_conserved(0,0,blk.omegaz);
+    }
+    evalRHS(0.0,0);
+    auto output=File("trace-wall-pipeline.csv", "w");
+    output.writeln("id,x,y,expected,actual,wall_temperature");
+    foreach (blk; localFluidBlocks) foreach (f; blk.faces) {
+        if (!f.is_on_boundary || !blk.bc[f.bc_id].is_wall_with_viscous_effects) continue;
+        number actual=-f.grad.T[0]*f.n.x-f.grad.T[1]*f.n.y;
+        output.writefln("%d,%.17e,%.17e,%.17e,%.17e,%.17e",
+            f.id,f.pos.x.re,f.pos.y.re,1.0e4,actual.re,f.fs.gas.T.re);
+    }
+}
