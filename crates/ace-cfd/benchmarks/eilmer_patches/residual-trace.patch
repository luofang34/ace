+void aceTraceAxisConsistency()
+{
+    // This manufactured field is evaluated only after the saved-state trace.
+    // It never enters pseudo-time iteration or checkpoint output.
+    auto output = File("trace-axis-consistency.csv", "w");
+    output.writeln("id,x,y,expected,actual,axis_velocity");
+    foreach (blk; localFluidBlocks) {
+        foreach (c; blk.cells) { c.fs.vel.x=0.0; c.fs.vel.y=1000.0*c.pos[0].y; c.fs.vel.z=0.0; }
+        foreach (f; blk.faces) { f.fs.vel.x=0.0; f.fs.vel.y=1000.0*f.pos.y; f.fs.vel.z=0.0; }
+        blk.applyPreSpatialDerivActionAtBndryFaces(0.0, 0, 0);
+        blk.flow_property_spatial_derivatives(0);
+        foreach (f; blk.faces) {
+            if (f.pos.y != 0.0) continue;
+            auto c = f.right_cell;
+            if (c is null || !c.is_interior_to_domain) c = f.left_cell;
+            // Exclude intersections with the inflow and no-slip wall.
+            bool corner = false;
+            foreach (cf; c.iface) if (cf.is_on_boundary && cf.pos.y != 0.0) corner = true;
+            if (corner) continue;
+            output.writefln("%d,%.17e,%.17e,%.17e,%.17e,%.17e", c.id,
+                c.pos[0].x.re, c.pos[0].y.re, 1000.0, c.grad.vel[1][1].re, f.fs.vel.y.re);
+        }
+    }
+}
+
+void aceTraceAffineStrain()
+{
+    foreach (blk; localFluidBlocks) {
+        auto gmodel=blk.myConfig.gmodel;
+        foreach (c; blk.cells) {
+            c.fs.gas.p=300.0; c.fs.gas.T=300.0;
+            gmodel.update_thermo_from_pT(c.fs.gas);
+            gmodel.update_trans_coeffs(c.fs.gas);
+            c.fs.vel.x=-2000.0*c.pos[0].x;
+            c.fs.vel.y=1000.0*c.pos[0].y; c.fs.vel.z=0.0;
+            c.encode_conserved(0, 0, blk.omegaz);
+        }
+    }
+    evalRHS(0.0, 0);
+    aceTraceFaces("strain-total.csv");
+    aceTraceCells();
+    std.file.rename("trace-cells.csv", "strain-cells.csv");
+    std.file.rename("trace-inviscid.csv", "strain-inviscid.csv");
+}
+
+void aceTraceWallConsistency()
+{
+    auto output=File("trace-wall-consistency.csv", "w");
+    output.writeln("id,x,y,distance,curvature,expected,actual");
+    foreach (blk; localFluidBlocks) {
+        foreach (f; blk.faces) {
+            if (!f.is_on_boundary || !blk.bc[f.bc_id].is_wall_with_viscous_effects) continue;
+            auto c=f.left_cell;
+            if (c is null || !c.is_interior_to_domain) c=f.right_cell;
+            // Each cloud receives exact samples from a polynomial normal to its wall plane.
+            foreach (curvature; [0.0, 1.0e9]) {
+                foreach (i,p; c.cloud_pos) {
+                    number d=-(p.x-f.pos.x)*f.n.x-(p.y-f.pos.y)*f.n.y;
+                    c.cloud_fs[i].gas.T=300.0+3.0e6*d+curvature*d*d;
+                }
+                c.grad.gradients_leastsq(c.cloud_fs,c.cloud_pos,*(c.ws_grad));
+                f.average_cell_deriv_values(0);
+                number d=-(c.pos[0].x-f.pos.x)*f.n.x-(c.pos[0].y-f.pos.y)*f.n.y;
+                number actual=-f.grad.T[0]*f.n.x-f.grad.T[1]*f.n.y;
+                output.writefln("%d,%.17e,%.17e,%.17e,%.17e,%.17e,%.17e",
+                    f.id,f.pos.x.re,f.pos.y.re,d.re,curvature,3.0e6,actual.re);
+            }
+        }
+    }
+}
