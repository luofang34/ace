+double acceptedSteadyResidualNorm(double simTime)
+{
+    evalRHS(simTime, 0);
+    size_t nConserved = GlobalConfig.cqi.n;
+    if (GlobalConfig.cqi.n_species > 1) nConserved -= 1;
+    foreach (blk; parallel(localFluidBlocks, 1)) {
+        auto cqi = blk.myConfig.cqi;
+        blk.dotAcc = 0.0;
+        foreach (cell; blk.cells) {
+            foreach (j; 0 .. nConserved) {
+                if (!GlobalConfig.sssOptions.include_turb_quantities_in_residual &&
+                    j >= cqi.rhoturb && j < cqi.rhoturb + cqi.n_turb) continue;
+                double value = cell.dUdt[0][j].re;
+                blk.dotAcc += value * value;
+            }
+        }
+    }
+    double norm = 0.0;
+    foreach (blk; localFluidBlocks) norm += blk.dotAcc;
+    version(mpi_parallel) {
+        MPI_Allreduce(MPI_IN_PLACE, &norm, 1, MPI_DOUBLE, MPI_SUM, MPI_COMM_WORLD);
+    }
+    return sqrt(norm);
+}
 
