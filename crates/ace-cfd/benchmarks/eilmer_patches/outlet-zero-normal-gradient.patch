+                bc[iface.bc_id].type == "outflow_simple_flux_zero_normal_gradient") {
+                // This reference condition prescribes normal derivatives, not
+                // zero traction: tangential shear and axisymmetric strain remain.
+                if (myConfig.turb_model.isTurbulent || myConfig.gmodel.n_modes != 0 ||
+                    myConfig.gmodel.n_species != 1 ||
+                    myConfig.spatial_deriv_locn != SpatialDerivLocn.cells) {
