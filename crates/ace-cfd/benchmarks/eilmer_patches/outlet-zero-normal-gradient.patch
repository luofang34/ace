+                    number derivative = 0.0;
+                    foreach (axis; 0 .. 3) derivative += iface.grad.vel[component][axis]*normal[axis];
+                    foreach (axis; 0 .. 3) iface.grad.vel[component][axis] -= derivative*normal[axis];
+                }
+                number derivative = 0.0;
+                foreach (axis; 0 .. 3) derivative += iface.grad.T[axis]*normal[axis];
